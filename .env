# Password to protect /dashboard and the admin API routes.
# Leave unset during local testing to disable auth entirely.
DASHBOARD_PASSWORD=change-me

# These are auto-populated when you add a Redis (Upstash) storage
# integration to your project from the Vercel Marketplace — you normally
# don't set them by hand. Either naming works, the client checks both:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

UPSTASH_REDIS_REST_URL="https://ruling-bull-160240.upstash.io"
UPSTASH_REDIS_REST_TOKEN="gQAAAAAAAnHwAAIgcDI0OGIwMzgxM2I1NjI0ODE2OGFiNGRiYWZkZGJlODQ4MQ"

KV_REST_API_READ_ONLY_TOKEN="ggAAAAAAAnHwAAIgcDLn3a8QXasCDnUJ7ZnWSvMv-JL6ECntW5uRstZKdSFoFA"
KV_REST_API_TOKEN="gQAAAAAAAnHwAAIgcDI0OGIwMzgxM2I1NjI0ODE2OGFiNGRiYWZkZGJlODQ4MQ"
KV_REST_API_URL="https://ruling-bull-160240.upstash.io"
KV_URL="rediss://default:gQAAAAAAAnHwAAIgcDI0OGIwMzgxM2I1NjI0ODE2OGFiNGRiYWZkZGJlODQ4MQ@ruling-bull-160240.upstash.io:6379"
REDIS_URL="rediss://default:gQAAAAAAAnHwAAIgcDI0OGIwMzgxM2I1NjI0ODE2OGFiNGRiYWZkZGJlODQ4MQ@ruling-bull-160240.upstash.io:6379"
