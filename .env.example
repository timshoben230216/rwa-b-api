# Required. Password to protect /dashboard and the admin API routes.
# Without this set, those routes fail closed (500) rather than being open.
DASHBOARD_PASSWORD=change-me

# These are auto-populated when you add a Redis (Upstash) storage
# integration to your project from the Vercel Marketplace — you normally
# don't set them by hand. Either naming works, the client checks both:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
